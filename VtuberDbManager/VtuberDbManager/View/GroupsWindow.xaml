<Window x:Class="VtuberDbManager.View.GroupsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VtuberDbManager.View"
        xmlns:ViewModel="clr-namespace:VtuberDbManager.ViewModel"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=ViewModel:GroupsWindowViewModel, IsDesignTimeCreatable=True}"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        Title="GroupsWindow" Height="450" Width="400"
        Closed="Window_Closed">

    <i:Interaction.Triggers>
        <i:EventTrigger EventName="ContentRendered">
            <i:InvokeCommandAction Command="{Binding ContentRenderedCommand}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="25" />
            <RowDefinition Height="80" />
        </Grid.RowDefinitions>

        <DataGrid Grid.Row="0"
                  ItemsSource="{Binding Groups}"
                  CanUserAddRows="False"
                  CanUserResizeColumns="False"
                  CanUserReorderColumns="False"
                  AutoGenerateColumns="False"
                  SelectedItem="{Binding SelectedGroup.Value}"
                  HeadersVisibility="Column"
                  SelectionMode="Single"
                  RowHeaderWidth="0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="グループ名"
                                    Binding="{Binding Name.Value}"
                                    Width="*"
                                    x:Name="PlatformNameColumn" />
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="1"
            Orientation="Horizontal"
            HorizontalAlignment="Right">
            <Button Content="選択行を更新"
                    Width="80"
                    Command="{Binding UpdateCommand}" />
            <Button Content="選択行を削除"
                    Width="80"
                    Command="{Binding DeleteCommand}" />
        </StackPanel>

        <StackPanel Grid.Row="2"
            Orientation="Vertical"
            Margin="0,20,0,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="グループ名"
                   Width="{Binding ElementName=PlatformNameColumn, Path=ActualWidth}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal">
                <TextBox Text="{Binding NewName.Value, UpdateSourceTrigger=PropertyChanged}"
                         Width="{Binding ElementName=PlatformNameColumn, Path=ActualWidth}" />
            </StackPanel>

            <Button Content="追加"
            HorizontalAlignment="Right"
            Width="80"
                    Command="{Binding AddCommand}" />
        </StackPanel>
    </Grid>
</Window>